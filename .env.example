# Copy this file to .env and set your own values. .env is ignored by Git.
# Quote a value that contains spaces or a # character.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=social_connect
DB_USER=social_app
DB_PASS=change-me

# Set when the app lives in a sub-folder, for example /social-connect. Leave empty at the web root.
APP_BASE_PATH=

# 1 shows error details and puts the password reset link on the page instead of emailing it.
# Keep it at 0 on a public server.
APP_DEBUG=0

# Email through Resend (https://resend.com, free for 3,000 emails a month and 100 a day).
# Leave RESEND_API_KEY empty to write emails to storage/outbox instead of sending them.
# MAIL_FROM must use a domain you verified in Resend. Without one, Resend only accepts
# onboarding@resend.dev as the sender and only delivers to your own Resend account address.
RESEND_API_KEY=
MAIL_FROM="Social Connect <no-reply@social.example.com>"
